.field public static final JS_DOUBLE_CLICK_VIDEO:Ljava/lang/String; = "(function() {  var target = null;  var vid = document.querySelector(\'video\');  if (vid) {    var p = vid.parentElement;    for (var i = 0; i < 4 && p; i++) {      var st = window.getComputedStyle(p);      if (st.position !== \'static\' || p.getAttribute(\'role\') === \'button\') {        target = p; break;      }      p = p.parentElement;    }    if (!target) target = vid;  }  if (!target) {    var sel = [\'[data-e2e=\"browse-video\"]\',\'[data-e2e=\"video-player\"]\',\'[data-e2e=\"feed-video\"]\'];    for (var s = 0; s < sel.length; s++) {      var el = document.querySelector(sel[s]);      if (el) { target = el; break; }    }  }  if (!target) { alert(\'TGAPP|video_not_found\'); return; }  var rect = target.getBoundingClientRect();  if (rect.width === 0 || rect.height === 0) { alert(\'TGAPP|video_not_visible\'); return; }  var cx = rect.left + rect.width / 2;  var cy = rect.top + rect.height / 2;  function mkPtr(type, detail) {    return new PointerEvent(type, {bubbles:true,cancelable:true,view:window,      clientX:cx,clientY:cy,screenX:cx,screenY:cy,      pointerId:1,pointerType:\'touch\',isPrimary:true,detail:detail||0});  }  function mkMouse(type, detail) {    return new MouseEvent(type, {bubbles:true,cancelable:true,view:window,      clientX:cx,clientY:cy,screenX:cx,screenY:cy,detail:detail||1});  }  target.dispatchEvent(mkPtr(\'pointerdown\',1));  target.dispatchEvent(mkMouse(\'mousedown\',1));  target.dispatchEvent(mkPtr(\'pointerup\',1));  target.dispatchEvent(mkMouse(\'mouseup\',1));  target.dispatchEvent(mkMouse(\'click\',1));  setTimeout(function() {    target.dispatchEvent(mkPtr(\'pointerdown\',2));    target.dispatchEvent(mkMouse(\'mousedown\',2));    target.dispatchEvent(mkPtr(\'pointerup\',2));    target.dispatchEvent(mkMouse(\'mouseup\',2));    target.dispatchEvent(mkMouse(\'click\',2));    target.dispatchEvent(new MouseEvent(\'dblclick\',{bubbles:true,cancelable:true,      view:window,clientX:cx,clientY:cy,screenX:cx,screenY:cy,detail:2}));    alert(\'TGAPP|video_double_clicked\');  }, 200);})();"

.field public static final JS_PAGE_SCAN:Ljava/lang/String; = "(function(){var body=(document.body||document.documentElement);var txt=(body.innerText||body.textContent||\'\').toLowerCase().substring(0,500);alert(\'TGAPP|page_scan_txt|\'+txt);})();"

